# The gitignored files a new worktree is seeded with, in .gitignore syntax. A
# file is copied when it both matches a pattern here and is ignored by
# .gitignore. Each is a local record or a local install that a worktree needs
# on day one and the repository never carries. Promote an edit made inside a
# worktree back to the canonical checkout with
# ~/.claude/scripts/Sync-WorktreeConfig.ps1, run from that worktree.
node_modules/
.env
.claude/settings.local.json

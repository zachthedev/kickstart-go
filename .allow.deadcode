# Deadcode allow list.
# Every entry must have a # [category] comment above its group.
# Entries without a category tag will fail the check.
#
# Regenerate: go tool task deadcode ARGS=update
#
# Categories:
#   [public-api]  exported API not yet called from cmd/
#   [test-only]   called from _test.go files; deadcode can't trace test imports
#   [platform]    platform-specific code not built on current OS
#   [scaffold]    framework wiring for future use

# [test-only]
internal/gittest/gittest.go Isolate
internal/gittest/standin.go NewStandIn
internal/gittest/standin.go StandIn.Started
internal/gittest/standin.go StandIn.release
internal/gittest/standin.go StandInMain
internal/gittest/standin.go checkStandIn
internal/gittest/standin.go isStandIn
internal/gittest/standin.go runStandIn
internal/gittest/standin.go standInGit
internal/gittest/standin.go standInName
